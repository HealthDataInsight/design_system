<div class="<%= brand %>-card">
  <div class="<%= brand %>-card__heading-container">
    <%= helpers.ds_heading(title, level: heading_level, class: "#{brand}-card__heading #{brand}-heading-m") %>
    <% if actions.any? %>
      <ul class="<%= brand %>-card__actions">
        <% actions.each do |action| %>
          <li class="<%= brand %>-card__action"><%= render_action(action) %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
  <div class="<%= brand %>-card__content">
    <%= content %>
  </div>
</div>
